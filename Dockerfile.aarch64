# syntax=docker/dockerfile:1

FROM ghcr.io/linuxserver/baseimage-selkies:arm64v8-ubunturesolute

ARG BUILD_DATE
ARG VERSION
ARG NOMACS_VERSION
LABEL build_version="Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}"
LABEL maintainer="aptalca"

ENV \
  DEBIAN_FRONTEND="noninteractive" \
  HOME=/config \
  TITLE="nomacs" \
  NO_GAMEPAD=true \
  PIXELFLUX_WAYLAND=true

RUN \
  echo "**** add icon ****" && \
  curl -o \
    /usr/share/selkies/www/icon.png \
    https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/nomacs-logo.png && \
  echo "**** install nomacs ****" && \
  if [ -z "${NOMACS_VERSION}" ]; then \
    NOMACS_VERSION=$(curl -sX GET https://api.github.com/repos/nomacs/nomacs/releases | \
      jq -r '.[] | select(.prerelease != true) | select(.assets.[].name | contains("x86_64.AppImage")) | select(.assets.[].name | contains("aarch64.AppImage")) | .tag_name' | \
      sort -rV | head -1); \
  fi && \
  cd /tmp && \
  curl -fo \
    /tmp/nomacs.app -L \
    "https://github.com/nomacs/nomacs/releases/download/${NOMACS_VERSION}/nomacs-linux-aarch64.AppImage" && \
  chmod +x /tmp/nomacs.app && \
  ./nomacs.app --appimage-extract && \
  mv squashfs-root /opt/nomacs && \
  find /opt/nomacs -type d -exec chmod 755 {} + && \
  printf "Linuxserver.io version: ${VERSION}\nBuild-date: ${BUILD_DATE}" > /build_version && \
  echo "**** clean up ****" && \
  rm -rf \
    /tmp/* \
    /var/lib/apt/lists/* \
    /var/tmp/*

# add local files
COPY root/ /
